{
  "name": "ai-repo-inspector-assessment-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Inspects Git working-tree and branch changes and runs allowlisted validation commands, for developers (CLI) and AI coding agents (MCP).",
  "bin": {
    "inspector": "./dist/cli/main.js",
    "inspector-mcp": "./dist/mcp/server.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "inspector": "tsx src/cli/main.ts",
    "mcp-server": "tsx src/mcp/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "verify": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19"
  },
  "overrides": {
    "@hono/node-server": "2.0.10"
  }
}
